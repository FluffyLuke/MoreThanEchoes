--- !u!1001 &7268561922346576413
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 299992585}
    m_Modifications:
    - target: {fileID: 3893463633937401976, guid: 24e70d00260178029b36ff84b19525b4, type: 3}
      propertyPath: m_Name
      value: Exposition
      objectReference: {fileID: 0}
    - target: {fileID: 6776095060359607615, guid: 24e70d00260178029b36ff84b19525b4, type: 3}
      propertyPath: m_text
      value: 'You barely managed to close the gate behind you. Even if the sound
        of footsteps disappeared after the first station, the sensation of being
        watched never left you fully.


        Those creatures... tall and slender
        abominations... Your thoughts were fully occupied by them and fright; that
        gate may not last. Fortunately, glancing back revealed an empty corridor
        with no one near the gate.


        You gave the menacing hole one more
        look before running towards your car and driving all the way back to your
        home.'
      objectReference: {fileID: 0}
